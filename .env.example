# Copy this file to .env and fill in your own key. Never commit .env.

# Which provider to call. Defaults to "openrouter" — that's the credit pool
# this team is actually using. Set to "anthropic" to hit the Anthropic API
# directly instead.
MODEL_PROVIDER=openrouter

# --- openrouter provider (default) ---
OPENROUTER_API_KEY=
MODEL_A=anthropic/claude-haiku-4.5
MODEL_B=anthropic/claude-sonnet-5

# --- anthropic provider ---
# Set MODEL_PROVIDER=anthropic and fill this in instead.
ANTHROPIC_API_KEY=
# MODEL_A=claude-haiku-4-5-20251001
# MODEL_B=claude-sonnet-5
